#!/usr/bin/env python3
"""Keybind cheatsheet data for the mumeyong shell.

  keyhints --json   grouped list of every active Hyprland bind, as JSON; the
                    shell's SUPER+H sidebar (CheatsheetSidebar.qml) reads this
  keyhints          same list in a fuzzel popup (standalone fallback; running
                    it again closes the popup)

Labels come from the bind descriptions in hyprland.lua; binds added by the
shell's generated config have no description, so their label is derived from
the action in ~/.local/share/ambxst/hyprland.lua.
"""
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
SHELL_LUA = f"{HOME}/.local/share/ambxst/hyprland.lua"
COLORS = f"{HOME}/.cache/ambxst/colors.json"
PROMPT = "keys  "

MODS = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]
KEY_NAMES = {
    "mouse:272": "Left drag", "mouse:273": "Right drag",
    "mouse_down": "Scroll down", "mouse_up": "Scroll up",
    "Return": "Enter", "SPACE": "Space", "space": "Space",
    "Super_L": "(tap Super)", "PERIOD": ".", "period": ".", "COMMA": ",", "comma": ",",
    "bracketleft": "[", "bracketright": "]", "equal": "=", "minus": "-",
    "TAB": "Tab", "ESCAPE": "Esc",
    "left": "←", "right": "→", "up": "↑", "down": "↓",
    "Left": "←", "Right": "→", "Up": "↑", "Down": "↓",
    "XF86AudioRaiseVolume": "Volume Up", "XF86AudioLowerVolume": "Volume Down",
    "XF86AudioMute": "Mute", "XF86AudioMicMute": "Mic Mute",
    "XF86AudioPlay": "Play", "XF86AudioPause": "Pause", "XF86AudioNext": "Next",
    "XF86AudioPrev": "Previous", "XF86AudioStop": "Stop", "XF86AudioMedia": "Media",
    "XF86MonBrightnessUp": "Brightness Up", "XF86MonBrightnessDown": "Brightness Down",
    "XF86KbdBrightnessUp": "Kbd Light Up", "XF86KbdBrightnessDown": "Kbd Light Down",
    "XF86Calculator": "Calculator", "XF86Sleep": "Sleep",
}
# Binds that are noise in a cheatsheet (shifted-digit duplicates, lid switch).
SKIP_KEYS = {"exclam", "at", "numbersign", "dollar", "percent", "asciicircum",
             "ampersand", "asterisk", "parenleft", "parenright", "XF86Calculator"}
# Friendlier names for shell features and common commands.
FRIENDLY = {
    "config": "shell settings", "powermenu": "power menu", "screenrecord": "screen record",
    "lens": "lens (search the screen)", "tmux": "tmux sessions", "tools": "tools",
    "toggle bar": "toggle bar", "reload": "reload shell", "quit": "quit shell",
    "loginctl lock-session": "lock screen", "playerctl play-pause": "play/pause",
    "playerctl next": "next track", "playerctl previous": "previous track", "playerctl stop": "stop",
    "assistant": "keybind cheatsheet (this list)",
}
HIDDEN = object()  # marker for binds that only work in the scrolling layout (unused here)

# Sidebar sections, in display order. "Essentials" repeats the keys worth
# learning first; every bind also appears in its own section.
GROUPS = ["Essentials", "Shell & apps", "Windows", "Workspaces", "Screenshots & tools", "Media & hardware"]
ESSENTIALS = ["SUPER + H", "SUPER + Enter", "SUPER + D", "SUPER + Q", "SUPER + 1…",
              "SUPER + SHIFT + 1…", "SUPER + Left drag", "SUPER + W", "SUPER + SHIFT + C",
              "CTRL + ALT + L", "CTRL + ALT + P"]


def combo_key(mods, key):
    return "+".join(sorted(mods)) + "|" + key.upper()


def shell_labels():
    """Map normalized combo -> label for binds in the shell's generated Lua."""
    labels = {}
    try:
        lines = open(SHELL_LUA, encoding="utf-8").read().splitlines()
    except OSError:
        return labels
    i = 0
    while i < len(lines):
        m = re.match(r'\s*hl\.bind\("([^"]+)",\s*(.*)$', lines[i])
        i += 1
        if not m:
            continue
        action = m.group(2)
        # Multi-line function binds run until a line that is just "end)".
        if action.rstrip().endswith("function()"):
            while i < len(lines) and not re.match(r"^end\)", lines[i]):
                action += " " + lines[i].strip()
                i += 1
            i += 1
        parts = [p.strip() for p in m.group(1).split("+")]
        key, mods = parts[-1], parts[:-1]
        labels[combo_key(mods, key)] = describe(action)
    return labels


def describe(action):
    if action.startswith("function"):
        if "window.resize" in action:
            delta = re.search(r"local delta = (-?\d+)", action)
            if delta:  # vertical resize, delta is the y step
                return "resize window " + ("taller" if int(delta.group(1)) > 0 else "shorter")
            x = re.search(r"resize\(\{ x = (-?\d+)", action)
            return "resize window " + ("wider" if x and int(x.group(1)) > 0 else "narrower")
        if 'tiled_layout == "scrolling"' in action and "else" not in action:
            return HIDDEN
        dirs = {"u": "up", "d": "down", "l": "left", "r": "right"}
        d = re.search(r'direction = "(\w)"', action)
        return f"focus {dirs.get(d.group(1), d.group(1))}" if d else "custom action"
    cmd = re.search(r'exec_cmd\("((?:[^"\\]|\\.)*)"\)', action)
    if cmd:
        c = cmd.group(1)
        if "ambxst_ipc.pipe" in c:
            return "brightness " + ("up" if "up" in c else "down")
        c = re.sub(r"^ambxst (run )?", "", c)
        return FRIENDLY.get(c, c.replace("-", " "))
    m = re.search(r'hl\.dsp\.([\w.]+)\((.*?)\)\s*(?:,\s*\{.*\})?\)\s*$', action)
    if not m:
        return "action"
    name, args = m.group(1), m.group(2)
    if name == "window.fullscreen_state":
        return "fake fullscreen (app thinks it's fullscreen)"
    ws = re.search(r'workspace = "([^"]*)"', args)
    if name == "window.move" and ws:
        return f"move window to workspace {ws.group(1)}"
    if name == "focus" and ws:
        return {"+1": "next workspace", "-1": "previous workspace",
                "e+1": "next used workspace", "e-1": "previous used workspace"}.get(ws.group(1), f"workspace {ws.group(1)}")
    args = re.sub(r'[{}"]', "", args)
    args = re.sub(r"\b(action|mode)\s*=\s*", "", args)
    return f"{name.replace('.', ' ').replace('_', ' ')} {args}".strip().rstrip(",")


def entries():
    binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"], capture_output=True,
                                      text=True, check=True).stdout)
    labels = shell_labels()
    rows = []
    for b in binds:
        key = b["key"] or str(b.get("keycode", ""))
        if not key or key in SKIP_KEYS or key.startswith("switch:"):
            continue
        mods = [n for v, n in MODS if b["modmask"] & v]
        label = b.get("description") or labels.get(combo_key(mods, key), "action")
        if label is HIDDEN:
            continue
        rows.append((mods, key, label))
    return collapse_digits(rows)


def collapse_digits(rows):
    """SUPER+1..SUPER+6 'workspace N' style runs become one line ("1…6")."""
    groups, out = {}, []
    for mods, key, label in rows:
        if re.fullmatch(r"[0-9]", key):
            n = "10" if key == "0" else key
            template = re.sub(rf"\b{n}\b", "N", label, count=1)
            if template != label:
                groups.setdefault((tuple(mods), template), []).append((mods, key, label))
                continue
        out.append((mods, key, label))
    for (mods, template), members in groups.items():
        if len(members) >= 3:
            nums = sorted(10 if k == "0" else int(k) for _, k, _ in members)
            out.append((list(mods), f"1…{nums[-1] % 10}", template.replace("N", f"{nums[0]}–{nums[-1]}")))
        else:
            out.extend(members)
    return out


def key_name(key):
    return KEY_NAMES.get(key, key.upper() if len(key) == 1 else key)


def fmt(mods, key):
    return " + ".join(mods + [key_name(key)])


def group_of(mods, key, label):
    l = label.lower()
    if not mods or key.startswith("XF86") or any(w in l for w in (
            "volume", "brightness", "mute", "track", "play", "backlight", "suspend")):
        return "Media & hardware"
    if any(w in l for w in ("screenshot", "screen record", "lens", "tools")):
        return "Screenshots & tools"
    if "workspace" in l or "monitor" in l:
        return "Workspaces"
    if any(w in l for w in ("window", "focus", "move", "resize", "swap", "float", "fullscreen",
                            "maximize", "pseudotile", "split", "group", "close", "kill", "layout")):
        return "Windows"
    return "Shell & apps"


def essential_match(name, by_fmt):
    """Exact match, or for names ending in "…" the collapsed row ("SUPER + 1…" → "SUPER + 1…6")."""
    if name in by_fmt:
        return name
    if name.endswith("…"):
        return next((f for f in by_fmt if f.startswith(name) and f[len(name):].isdigit()), None)
    return None


def as_json(rows):
    """Rows grouped and ordered for the sidebar: [{group, keys, label}]."""
    order = lambda r: (r[0] != ["SUPER"], len(r[0]), fmt(r[0], r[1]).lower())
    by_fmt = {fmt(m, k): (m, k, label) for m, k, label in rows}
    items = [{"group": "Essentials", "keys": by_fmt[f][0] + [key_name(by_fmt[f][1])], "label": by_fmt[f][2]}
             for f in ESSENTIALS for f in [essential_match(f, by_fmt)] if f]
    for m, k, label in sorted(rows, key=lambda r: (GROUPS.index(group_of(*r)), order(r))):
        items.append({"group": group_of(m, k, label), "keys": m + [key_name(k)], "label": label})
    return json.dumps(items, ensure_ascii=False)


def fuzzel_colors():
    try:
        c = json.load(open(COLORS, encoding="utf-8"))
    except (OSError, ValueError):
        return []
    hx = lambda name, alpha="ff": c[name].lstrip("#") + alpha
    return [
        f"--background-color={hx('surfaceContainer', 'f2')}",
        f"--text-color={hx('overSurface')}",
        f"--prompt-color={hx('primary')}",
        f"--input-color={hx('overSurface')}",
        f"--placeholder-color={hx('outline')}",
        f"--match-color={hx('primary')}",
        f"--selection-color={hx('primaryContainer')}",
        f"--selection-text-color={hx('overPrimaryContainer')}",
        f"--selection-match-color={hx('overPrimaryContainer')}",
        f"--border-color={hx('primary')}",
        f"--counter-color={hx('outline')}",
    ]


def main():
    if "--json" in sys.argv[1:]:
        print(as_json(entries()))
        return
    # Toggle: running it again closes an open popup.
    if subprocess.run(["pkill", "-f", f"fuzzel.*--prompt={PROMPT}"]).returncode == 0:
        return
    # SUPER+key first, then longer combos, hardware keys (no modifier) last.
    rows = sorted(entries(), key=lambda r: (not r[0], r[0] != ["SUPER"], len(r[0]), fmt(r[0], r[1]).lower()))
    width = max(len(fmt(m, k)) for m, k, _ in rows) + 3
    text = "\n".join(f"{fmt(m, k):<{width}}{label}" for m, k, label in rows)
    subprocess.run(["fuzzel", "--dmenu", f"--prompt={PROMPT}", "--placeholder=type to search a key or action",
                    "--font=JetBrainsMono Nerd Font:size=11", "--width=72", "--lines=20",
                    "--border-width=2", "--border-radius=14", "--counter", "--no-sort",
                    *fuzzel_colors()], input=text, text=True, stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    sys.exit(main())
