 	args := os.Args[1:]
 
 	if len(args) >= 1 {
diff --git a/backend/cmd/ambxst/qsenv.go b/backend/cmd/ambxst/qsenv.go
new file mode 100644
index 0000000..9f813f8
--- /dev/null
+++ b/backend/cmd/ambxst/qsenv.go
@@ -0,0 +1,27 @@
+package main
+
+import (
+	"os"
+	"strings"
+)
+
+// quickshellCrashEnvPrefix marks the variables Quickshell's crash handler
+// sets when it relaunches a crashed shell in place (__QUICKSHELL_CRASH_INFO_FD
+// and friends). Quickshell never clears them afterwards, so every process the
+// relaunched shell spawns inherits them — including `ambxst brightness -r`
+// from the onResume hook. Any `qs` started with __QUICKSHELL_CRASH_INFO_FD set
+// takes the crash-relaunch path and boots a second full shell instead of
+// running its subcommand (e.g. `qs ipc ... brightness pull`), which doubles
+// the bar and its exclusive zone.
+const quickshellCrashEnvPrefix = "__QUICKSHELL_CRASH_"
+
+// scrubQuickshellCrashEnv removes the inherited crash-relaunch variables so
+// no `qs` child of this process mistakes itself for a crash relaunch.
+func scrubQuickshellCrashEnv() {
+	for _, kv := range os.Environ() {
+		name, _, _ := strings.Cut(kv, "=")
+		if strings.HasPrefix(name, quickshellCrashEnvPrefix) {
+			_ = os.Unsetenv(name)
+		}
+	}
+}
diff --git a/backend/cmd/ambxst/qsenv_test.go b/backend/cmd/ambxst/qsenv_test.go
new file mode 100644
index 0000000..cb4a573
--- /dev/null
+++ b/backend/cmd/ambxst/qsenv_test.go
@@ -0,0 +1,23 @@
+package main
+
+import (
+	"os"
+	"testing"
+)
+
+func TestScrubQuickshellCrashEnv(t *testing.T) {
+	t.Setenv("__QUICKSHELL_CRASH_INFO_FD", "5")
+	t.Setenv("__QUICKSHELL_CRASH_DUMP_PID", "1234")
+	t.Setenv("QS_ICON_THEME", "keep-me")
+
+	scrubQuickshellCrashEnv()
+
+	for _, name := range []string{"__QUICKSHELL_CRASH_INFO_FD", "__QUICKSHELL_CRASH_DUMP_PID"} {
+		if _, ok := os.LookupEnv(name); ok {
+			t.Errorf("%s still set after scrub", name)
+		}
+	}
+	if got := os.Getenv("QS_ICON_THEME"); got != "keep-me" {
+		t.Errorf("QS_ICON_THEME = %q, want it untouched", got)
+	}
+}
