diff --git a/modules/shell/osd/OSD.qml b/modules/shell/osd/OSD.qml
new file mode 100644
index 0000000..85a5aba
--- /dev/null
+++ b/modules/shell/osd/OSD.qml
@@ -0,0 +1,164 @@
+pragma ComponentBehavior: Bound
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Wayland
+import qs.modules.components
+import qs.modules.theme
+import qs.modules.services
+import qs.config
+
+// macOS-style volume / mic / brightness OSD: a card in the top-right corner,
+// below the bar, on the focused monitor. State comes from OsdService.
+PanelWindow {
+    id: root
+
+    property ShellScreen targetScreen
+    screen: targetScreen
+
+    readonly property bool isScreenFocused: AxctlService.focusedMonitor && AxctlService.focusedMonitor.name === targetScreen.name
+    readonly property bool shown: OsdService.visible && isScreenFocused
+    readonly property bool isBrightness: OsdService.indicator === "brightness"
+    readonly property real level: Math.max(0, Math.min(1, OsdService.value))
+
+    WlrLayershell.layer: WlrLayer.Overlay
+    WlrLayershell.namespace: "ambxst:osd"
+    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
+    // Respect the bar's reserved zone so the card sits right below it
+    exclusiveZone: 0
+
+    anchors.top: true
+    anchors.right: true
+
+    implicitWidth: card.width + 16
+    implicitHeight: card.height + 16
+    color: "transparent"
+    visible: shown || card.opacity > 0
+
+    // Never take input; clicks pass through to whatever is below
+    mask: Region {}
+
+    StyledRect {
+        id: card
+        variant: "popup"
+        width: 300
+        height: 76
+        y: 8
+        x: root.shown ? 8 : 8 + 24
+        opacity: root.shown ? 1 : 0
+        radius: Styling.radius(4)
+
+        Behavior on x {
+            enabled: Config.animDuration > 0
+            NumberAnimation {
+                duration: Config.animDuration
+                easing.type: Easing.OutQuart
+            }
+        }
+
+        Behavior on opacity {
+            enabled: Config.animDuration > 0
+            NumberAnimation {
+                duration: Config.animDuration
+                easing.type: Easing.OutQuart
+            }
+        }
+
+        ColumnLayout {
+            anchors.fill: parent
+            anchors.margins: 14
+            spacing: 8
+
+            RowLayout {
+                Layout.fillWidth: true
+                spacing: 0
+
+                Text {
+                    text: {
+                        if (OsdService.indicator === "volume")
+                            return I18n.t("osd.volume");
+                        if (OsdService.indicator === "mic")
+                            return I18n.t("osd.mic");
+                        return I18n.t("osd.brightness");
+                    }
+                    font.family: Config.theme.font
+                    font.pixelSize: Styling.fontSize(0)
+                    font.bold: true
+                    color: Colors.overBackground
+                }
+
+                Item {
+                    Layout.fillWidth: true
+                }
+
+                Text {
+                    text: OsdService.muted ? "Muted" : Math.round(OsdService.value * 100) + "%"
+                    font.family: Config.theme.font
+                    font.pixelSize: Styling.fontSize(-1)
+                    color: Colors.outline
+                }
+            }
+
+            // Thick pill slider with the icon inside, like the macOS control center
+            Rectangle {
+                id: track
+                Layout.fillWidth: true
+                Layout.preferredHeight: 24
+                radius: Config.roundness > 0 ? height / 2 : 0
+                color: Qt.rgba(Colors.overBackground.r, Colors.overBackground.g, Colors.overBackground.b, 0.15)
+                clip: true
+
+                Rectangle {
+                    id: fill
+                    anchors.left: parent.left
+                    anchors.top: parent.top
+                    anchors.bottom: parent.bottom
+                    width: Math.max(track.height, track.width * root.level)
+                    radius: track.radius
+                    color: OsdService.muted ? Colors.outline : Colors.primary
+
+                    Behavior on width {
+                        enabled: Config.animDuration > 0
+                        NumberAnimation {
+                            duration: Config.animDuration
+                            easing.type: Easing.OutQuart
+                        }
+                    }
+
+                    Behavior on color {
+                        enabled: Config.animDuration > 0
+                        ColorAnimation {
+                            duration: Config.animDuration
+                        }
+                    }
+                }
+
+                Text {
+                    width: track.height
+                    height: track.height
+                    horizontalAlignment: Text.AlignHCenter
+                    verticalAlignment: Text.AlignVCenter
+                    text: {
+                        if (OsdService.indicator === "volume")
+                            return Audio.volumeIcon(OsdService.value, OsdService.muted);
+                        if (OsdService.indicator === "mic")
+                            return OsdService.muted ? Icons.micSlash : Icons.mic;
+                        return Icons.sun;
+                    }
+                    font.family: Icons.font
+                    font.pixelSize: 14
+                    color: Colors.overPrimary
+                    rotation: root.isBrightness ? root.level * 180 : 0
+
+                    Behavior on rotation {
+                        enabled: Config.animDuration > 0
+                        NumberAnimation {
+                            duration: Config.animDuration
+                            easing.type: Easing.OutQuart
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
