From baac87be849a8b8553233f1f3edffe8b06d04d14 Mon Sep 17 00:00:00 2001
From: "mumeyong.dev" <64839630+mumeyong@users.noreply.github.com>
Date: Tue, 3 Nov 2026 16:58:25 +0700
Subject: [PATCH 12/12] Mpris: don't reselect the player being removed

When the tracked player disappears, the fallback read playbackState.isPlaying
(which throws) and could pick the dying player from the stale filteredPlayers
list, leaving activePlayer pointing at a destroyed object and crashing
Quickshell when mpv closed.
---
 modules/services/MprisController.qml | 16 +++++-----------
 1 file changed, 5 insertions(+), 11 deletions(-)

diff --git a/modules/services/MprisController.qml b/modules/services/MprisController.qml
index 0443fe9..9837f9b 100644
--- a/modules/services/MprisController.qml
+++ b/modules/services/MprisController.qml
@@ -170,17 +170,11 @@ Singleton {
 
             Component.onDestruction: {
                 if (root.trackedPlayer === modelData) {
-                    for (let i = 0; i < root.filteredPlayers.length; i++) {
-                        const player = root.filteredPlayers[i];
-                        if (player.playbackState.isPlaying) {
-                            root.trackedPlayer = player;
-                            break;
-                        }
-                    }
-
-                    if (root.trackedPlayer === modelData) {
-                        root.trackedPlayer = root.filteredPlayers.length > 0 ? root.filteredPlayers[0] : null;
-                    }
+                    // filteredPlayers may still contain the player being destroyed,
+                    // so never hand it back as the replacement.
+                    const remaining = root.filteredPlayers.filter(player => player && player !== modelData);
+                    const playing = remaining.find(player => player.isPlaying);
+                    root.trackedPlayer = playing ? playing : (remaining.length > 0 ? remaining[0] : null);
                 }
             }
 
