diff --git a/modules/widgets/defaultview/NotchOsd.qml b/modules/widgets/defaultview/NotchOsd.qml
new file mode 100644
index 0000000..9bdb147
--- /dev/null
+++ b/modules/widgets/defaultview/NotchOsd.qml
@@ -0,0 +1,77 @@
+import QtQuick
+import QtQuick.Layouts
+import qs.modules.theme
+import qs.modules.services
+import qs.modules.components
+import qs.config
+
+// Volume / mic / brightness indicator that takes over the compact player pill.
+StyledRect {
+    id: root
+
+    variant: "common"
+    radius: Styling.radius(-4)
+
+    readonly property bool isBrightness: OsdService.indicator === "brightness"
+
+    RowLayout {
+        anchors.fill: parent
+        anchors.leftMargin: 12
+        anchors.rightMargin: 12
+        spacing: 10
+
+        Text {
+            text: {
+                if (OsdService.indicator === "volume")
+                    return Audio.volumeIcon(OsdService.value, OsdService.muted);
+                if (OsdService.indicator === "mic")
+                    return OsdService.muted ? Icons.micSlash : Icons.mic;
+                return Icons.sun;
+            }
+            textFormat: Text.RichText
+            font.family: Icons.font
+            font.pixelSize: 16
+            color: Colors.overBackground
+            rotation: root.isBrightness ? OsdService.value * 180 : 0
+            scale: root.isBrightness ? 0.8 + OsdService.value * 0.2 : 1
+
+            Behavior on rotation {
+                enabled: Config.animDuration > 0
+                NumberAnimation {
+                    duration: Config.animDuration
+                    easing.type: Easing.OutQuart
+                }
+            }
+
+            Behavior on scale {
+                enabled: Config.animDuration > 0
+                NumberAnimation {
+                    duration: Config.animDuration
+                    easing.type: Easing.OutQuart
+                }
+            }
+        }
+
+        StyledSlider {
+            Layout.fillWidth: true
+            Layout.preferredHeight: 12
+            value: OsdService.value
+            wavy: false
+            enabled: false
+            thickness: 3
+            handleSpacing: 0
+            progressColor: OsdService.muted ? Colors.outline : Styling.srItem("overprimary")
+            backgroundColor: Qt.rgba(Colors.overBackground.r, Colors.overBackground.g, Colors.overBackground.b, 0.2)
+        }
+
+        Text {
+            Layout.preferredWidth: 26
+            text: Math.round(OsdService.value * 100)
+            horizontalAlignment: Text.AlignRight
+            font.family: Config.theme.font
+            font.pixelSize: Styling.fontSize(0)
+            font.bold: true
+            color: OsdService.muted ? Colors.outline : Colors.overBackground
+        }
+    }
+}
