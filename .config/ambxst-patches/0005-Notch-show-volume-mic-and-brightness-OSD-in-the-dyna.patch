diff --git a/modules/services/OsdService.qml b/modules/services/OsdService.qml
new file mode 100644
index 0000000..f1a2847
--- /dev/null
+++ b/modules/services/OsdService.qml
@@ -0,0 +1,53 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+
+// Volume / mic / brightness OSD state, rendered inside the notch (NotchOsd).
+Singleton {
+    id: root
+
+    property bool visible: false
+    property string indicator: "volume" // volume, mic, brightness
+    property real value: 0
+    property bool muted: false
+
+    function show(kind: string, newValue: real, isMuted: bool) {
+        // Brightness and sinks settle right after resume; don't flash then
+        if (!SuspendManager.wakeReady)
+            return;
+        indicator = kind;
+        value = newValue;
+        muted = isMuted;
+        visible = true;
+        hideTimer.restart();
+    }
+
+    function hide() {
+        hideTimer.stop();
+        visible = false;
+    }
+
+    Timer {
+        id: hideTimer
+        interval: 2000
+        onTriggered: root.visible = false
+    }
+
+    Connections {
+        target: Audio
+        function onVolumeChanged(volume, muted, node) {
+            root.show("volume", volume, muted);
+        }
+        function onMicVolumeChanged(volume, muted, node) {
+            root.show("mic", volume, muted);
+        }
+    }
+
+    Connections {
+        target: Brightness
+        function onBrightnessChanged(value, screen) {
+            root.show("brightness", value, false);
+        }
+    }
+}
