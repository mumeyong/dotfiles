From d296881b6cc9ee1eefe0ec4d8990d03a8252c82a Mon Sep 17 00:00:00 2001
From: "mumeyong.dev" <64839630+mumeyong@users.noreply.github.com>
Date: Sat, 24 Oct 2026 17:43:19 +0700
Subject: [PATCH 4/5] GTK theme: dark variant, readable selections, see-through
 background

- Use adw-gtk3-dark when the generated colors are dark, so widgets the
  color overrides don't cover aren't drawn light with light text
- Accent/selection background uses primaryContainer with
  overPrimaryContainer text instead of the pastel primary, which made
  white selection text unreadable
- GTK window/view/headerbar background at 85% opacity (capped by the
  shell's own panel opacity) so apps like Thunar are see-through like
  the terminal
---
 modules/theme/GtkGenerator.qml | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/modules/theme/GtkGenerator.qml b/modules/theme/GtkGenerator.qml
index c1e737c..0b10549 100644
--- a/modules/theme/GtkGenerator.qml
+++ b/modules/theme/GtkGenerator.qml
@@ -27,8 +27,14 @@ QtObject {
         const darkMode = isDark(Colors.background)
 
         const primary = fmt(Colors.primary)
-        const onPrimary = fmt(Colors.overPrimary)
-        const background = toRgba(Colors.background, Config.theme.srBg.opacity)
+        // Selections and accent buttons draw light text, so give them the
+        // container shade (dark in dark mode) rather than the pastel primary.
+        const primaryContainer = fmt(Colors.primaryContainer)
+        const onPrimaryContainer = fmt(Colors.overPrimaryContainer)
+        // mumeyong: GTK apps (Thunar etc.) get a see-through background like the
+        // terminal; text and icons stay solid. Never more opaque than the shell's panels.
+        const gtkOpacity = Math.min(Config.theme.srBg.opacity, 0.85)
+        const background = toRgba(Colors.background, gtkOpacity)
         const onBackground = fmt(Colors.overBackground)
         const surface = fmt(Colors.surface)
         const onSurface = fmt(Colors.overSurface)
@@ -37,8 +43,8 @@ QtObject {
         let css = "/* GTK Colors generated by Ambxst */\n\n"
         
         css += `@define-color accent_color ${primary};\n`
-        css += `@define-color accent_fg_color ${onPrimary};\n`
-        css += `@define-color accent_bg_color ${primary};\n`
+        css += `@define-color accent_fg_color ${onPrimaryContainer};\n`
+        css += `@define-color accent_bg_color ${primaryContainer};\n`
         css += `@define-color window_bg_color ${background};\n`
         css += `@define-color window_fg_color ${onBackground};\n`
         css += `@define-color headerbar_bg_color ${background};\n`
@@ -68,7 +74,7 @@ QtObject {
             mkdir -p "${gtk3Dir}" "${gtk4Dir}" && \\
             echo "${css}" | tee "${gtk3Dir}/gtk.css" "${gtk4Dir}/gtk.css" > /dev/null && \\
             gsettings set org.gnome.desktop.interface gtk-theme "" && \\
-            gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3 && \\
+            gsettings set org.gnome.desktop.interface gtk-theme ${darkMode ? "adw-gtk3-dark" : "adw-gtk3"} && \\
             axctl darkmode ${darkMode ? "on" : "off"}
         `
         
