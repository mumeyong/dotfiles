+                    }
+                    Loader {
+                        id: vpnLoader
+                        anchors.fill: parent
+                        active: root.expandedPanel === 2
+                        source: "../controls/VpnPanel.qml"
+                        asynchronous: true
+                        
+                        opacity: root.expandedPanel === 2 ? 1 : 0
+                        x: root.panelOffset(2, width)
                         
                         onLoaded: {
                             if (item) {
@@ -200,6 +230,13 @@ StyledRect {
         }
     }
     
+    // Slide panels left of the open one out to the left, the rest out to the right
+    function panelOffset(index, width) {
+        if (root.expandedPanel === index)
+            return 0;
+        return index < root.expandedPanel ? -width : width;
+    }
+
     function togglePanel(index) {
