diff --git a/modules/services/VpnService.qml b/modules/services/VpnService.qml
new file mode 100644
index 0000000..3754b8d
--- /dev/null
+++ b/modules/services/VpnService.qml
@@ -0,0 +1,122 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// NetworkManager VPN profiles (OpenVPN, WireGuard, ...) via nmcli.
+Singleton {
+    id: root
+
+    // [{ uuid, name, type, state }] — state: "" | "activating" | "activated" | "deactivating"
+    property list<var> connections: []
+    property string busyUuid: ""
+    property string lastError: ""
+    property string lastUsedUuid: ""
+
+    readonly property bool available: connections.length > 0
+    readonly property var activeConnection: connections.find(c => c.state === "activated") ?? null
+    readonly property bool connected: activeConnection !== null
+    readonly property bool busy: busyUuid !== "" || connections.some(c => c.state === "activating" || c.state === "deactivating")
+
+    function update(): void {
+        if (!listProc.running)
+            listProc.running = true;
+    }
+
+    function connectVpn(uuid: string): void {
+        run(uuid, ["nmcli", "connection", "up", "uuid", uuid]);
+        lastUsedUuid = uuid;
+    }
+
+    function disconnectVpn(uuid: string): void {
+        run(uuid, ["nmcli", "connection", "down", "uuid", uuid]);
+    }
+
+    function toggleVpn(uuid: string): void {
+        const conn = connections.find(c => c.uuid === uuid);
+        if (conn && conn.state === "activated")
+            disconnectVpn(uuid);
+        else
+            connectVpn(uuid);
+    }
+
+    // Quick toggle: disconnect the active VPN, or connect the last used / first one.
+    function toggle(): void {
+        if (activeConnection) {
+            disconnectVpn(activeConnection.uuid);
+            return;
+        }
+        const target = connections.find(c => c.uuid === lastUsedUuid) ?? connections[0];
+        if (target)
+            connectVpn(target.uuid);
+    }
+
+    function run(uuid: string, command: list<string>): void {
+        if (actionProc.running)
+            return;
+        busyUuid = uuid;
+        lastError = "";
+        actionProc.command = command;
+        actionProc.running = true;
+    }
+
+    function parse(text: string): void {
+        const result = [];
+        for (const line of text.split("\n")) {
+            // Terse output: UUID:TYPE:STATE:NAME — name last since it may contain escaped colons
+            const m = line.match(/^([^:]+):([^:]+):([^:]*):(.*)$/);
+            if (!m || (m[2] !== "vpn" && m[2] !== "wireguard"))
+                continue;
+            result.push({
+                uuid: m[1],
+                type: m[2],
+                state: m[3],
+                name: m[4].replace(/\\:/g, ":")
+            });
+        }
+        connections = result;
+        if (!lastUsedUuid && activeConnection)
+            lastUsedUuid = activeConnection.uuid;
+    }
+
+    Process {
+        id: listProc
+        command: ["nmcli", "-t", "-f", "UUID,TYPE,STATE,NAME", "connection", "show"]
+        stdout: StdioCollector {
+            onStreamFinished: root.parse(text)
+        }
+    }
+
+    Process {
+        id: actionProc
+        stderr: StdioCollector {
+            onStreamFinished: {
+                if (text.trim().length > 0)
+                    root.lastError = text.trim().split("\n").pop();
+            }
+        }
+        onExited: (exitCode, exitStatus) => {
+            root.busyUuid = "";
+            root.update();
+        }
+    }
+
+    // Re-list whenever NetworkManager reports a change
+    Process {
+        running: true
+        command: ["nmcli", "monitor"]
+        stdout: SplitParser {
+            onRead: _ => refreshDebouncer.restart()
+        }
+    }
+
+    Timer {
+        id: refreshDebouncer
+        interval: 300
+        onTriggered: root.update()
+    }
+
+    Component.onCompleted: update()
+}
diff --git a/modules/widgets/dashboard/controls/VpnPanel.qml b/modules/widgets/dashboard/controls/VpnPanel.qml
new file mode 100644
index 0000000..4792350
--- /dev/null
+++ b/modules/widgets/dashboard/controls/VpnPanel.qml
@@ -0,0 +1,139 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Quickshell
+import qs.modules.theme
+import qs.modules.components
+import qs.modules.services
+import qs.config
+
+Item {
+    id: root
+
+    property int maxContentWidth: 480
+    readonly property int contentWidth: Math.min(width, maxContentWidth)
+
+    Component.onCompleted: VpnService.update()
+
+    ListView {
+        id: vpnList
+        anchors.fill: parent
+        clip: true
+        spacing: 4
+
+        model: VpnService.connections
+
+        header: Item {
+            width: vpnList.width
+            height: titlebar.height + 8
+
+            PanelTitlebar {
+                id: titlebar
+                width: root.contentWidth
+                anchors.horizontalCenter: parent.horizontalCenter
+                title: I18n.t("vpn.title")
+                statusText: VpnService.lastError !== "" ? I18n.t("vpn.failed") : (VpnService.busy ? I18n.t("vpn.working") : "")
+                statusColor: VpnService.lastError !== "" ? Colors.error : Styling.srItem("overprimary")
+                showToggle: VpnService.available
+                toggleChecked: VpnService.connected
+
+                actions: [
+                    {
+                        icon: Icons.popOpen,
+                        tooltip: I18n.t("wifi.network_settings"),
+                        onClicked: function () {
+                            Quickshell.execDetached(["nm-connection-editor"]);
+                        }
+                    }
+                ]
+
+                onToggleChanged: checked => {
+                    if (checked !== VpnService.connected)
+                        VpnService.toggle();
+                }
+            }
+        }
+
+        delegate: Item {
+            id: vpnItem
+            required property var modelData
+            readonly property bool active: modelData.state === "activated"
+            readonly property bool pending: VpnService.busyUuid === modelData.uuid || modelData.state === "activating" || modelData.state === "deactivating"
+
+            width: vpnList.width
+            height: 48
+
+            StyledRect {
+                width: root.contentWidth
+                height: parent.height
+                anchors.horizontalCenter: parent.horizontalCenter
+                variant: mouseArea.containsMouse ? "focus" : "common"
+                radius: Styling.radius(4)
+
+                MouseArea {
+                    id: mouseArea
+                    anchors.fill: parent
+                    hoverEnabled: true
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: VpnService.toggleVpn(vpnItem.modelData.uuid)
+                }
+
+                RowLayout {
+                    anchors.fill: parent
+                    anchors.leftMargin: 12
+                    anchors.rightMargin: 12
+                    spacing: 12
+
+                    Text {
+                        text: Icons.vpn
+                        font.family: Icons.font
+                        font.pixelSize: 20
+                        color: vpnItem.active ? Styling.srItem("overprimary") : Colors.overBackground
+                    }
+
+                    ColumnLayout {
+                        Layout.fillWidth: true
+                        spacing: 0
+
+                        Text {
+                            Layout.fillWidth: true
+                            text: vpnItem.modelData.name
+                            font.family: Config.theme.font
+                            font.pixelSize: Config.theme.fontSize
+                            font.weight: Font.Medium
+                            color: Colors.overBackground
+                            elide: Text.ElideRight
+                        }
+
+                        Text {
+                            Layout.fillWidth: true
+                            visible: vpnItem.active || vpnItem.pending
+                            text: vpnItem.pending ? I18n.t("vpn.working") : I18n.t("wifi.connected")
+                            font.family: Config.theme.font
+                            font.pixelSize: Styling.fontSize(-2)
+                            color: Colors.overSurfaceVariant
+                        }
+                    }
+
+                    Text {
+                        text: vpnItem.active ? I18n.t("wifi.disconnect") : I18n.t("wifi.connect")
+                        font.family: Config.theme.font
+                        font.pixelSize: Styling.fontSize(-1)
+                        color: vpnItem.active ? Colors.overSurfaceVariant : Styling.srItem("overprimary")
+                    }
+                }
+            }
+        }
+
+        Text {
+            anchors.centerIn: parent
+            visible: vpnList.count === 0
+            text: I18n.t("vpn.none")
+            font.family: Config.theme.font
+            font.pixelSize: Config.theme.fontSize
+            color: Colors.overSurfaceVariant
+        }
+    }
+}
