--- /dev/null
+++ b/assets/cava/notch.conf
@@ -0,0 +1,24 @@
+# Cava config for the notch visualizer (CavaService.qml).
+# Raw ASCII output: one line per frame, bar values 0-100 separated by ';'.
+
+[general]
+framerate = 60
+bars = 8
+autosens = 1
+
+[input]
+method = pulse
+source = auto
+
+[output]
+method = raw
+raw_target = /dev/stdout
+data_format = ascii
+ascii_max_range = 100
+bar_delimiter = 59
+frame_delimiter = 10
+channels = mono
+mono_option = average
+
+[smoothing]
+noise_reduction = 77
