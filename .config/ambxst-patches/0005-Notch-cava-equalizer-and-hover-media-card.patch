diff --git a/modules/services/CavaService.qml b/modules/services/CavaService.qml
new file mode 100644
index 0000000..44f4c3b
--- /dev/null
+++ b/modules/services/CavaService.qml
@@ -0,0 +1,37 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// Audio spectrum for the notch visualizer. Runs a private cava instance
+// (assets/cava/notch.conf) only while the active MPRIS player is playing.
+Singleton {
+    id: root
+
+    // Must match `bars` in assets/cava/notch.conf
+    readonly property int barCount: 8
+    // Bar levels in 0..1. All zeros while cava is stopped.
+    property var values: Array(barCount).fill(0)
+
+    Process {
+        id: cavaProcess
+        running: MprisController.isPlaying
+        command: ["cava", "-p", Quickshell.shellDir + "/assets/cava/notch.conf"]
+
+        stdout: SplitParser {
+            onRead: data => {
+                const parts = data.split(";");
+                const next = [];
+                for (let i = 0; i < root.barCount; i++)
+                    next.push((parseInt(parts[i]) || 0) / 100);
+                root.values = next;
+            }
+        }
+
+        onRunningChanged: {
+            if (!running)
+                root.values = Array(root.barCount).fill(0);
+        }
+    }
+}
diff --git a/modules/widgets/defaultview/CavaBars.qml b/modules/widgets/defaultview/CavaBars.qml
new file mode 100644
index 0000000..4aad789
--- /dev/null
+++ b/modules/widgets/defaultview/CavaBars.qml
@@ -0,0 +1,35 @@
+import QtQuick
+import qs.modules.services
+import qs.config
+
+// Center-aligned equalizer bars fed by CavaService.
+Row {
+    id: root
+
+    property color color: "white"
+    property real barWidth: 3
+
+    spacing: 2
+
+    Behavior on color {
+        enabled: Config.animDuration > 0
+        ColorAnimation {
+            duration: Config.animDuration
+            easing.type: Easing.OutQuart
+        }
+    }
+
+    Repeater {
+        model: CavaService.barCount
+
+        Rectangle {
+            required property int index
+
+            anchors.verticalCenter: parent.verticalCenter
+            width: root.barWidth
+            height: Math.max(root.barWidth, root.height * (CavaService.values[index] ?? 0))
+            radius: width / 2
+            color: root.color
+        }
+    }
+}
