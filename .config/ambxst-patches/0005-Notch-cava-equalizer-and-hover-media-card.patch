+    // Visualizer tint picked from the album art (most vivid swatch, lifted so it
+    // reads on the dark notch). Falls back to the theme primary when the art
+    // can't be sampled (ColorQuantizer only reads local files).
+    ColorQuantizer {
+        id: artQuantizer
+        source: compactPlayer.hasArtwork ? compactPlayer.player.trackArtUrl : ""
+        depth: 2
+        rescaleSize: 32
+    }
+
+    readonly property color accentColor: {
+        const swatches = artQuantizer.colors;
+        if (!hasArtwork || !swatches || swatches.length === 0)
+            return Colors.primary;
+        let best = swatches[0];
+        let bestScore = -1;
+        for (let i = 0; i < swatches.length; i++) {
+            const score = swatches[i].hsvSaturation * swatches[i].hsvValue;
+            if (score > bestScore) {
+                best = swatches[i];
+                bestScore = score;
+            }
+        }
+        return Qt.hsla(Math.max(0, best.hslHue), best.hslSaturation, Math.max(0.65, best.hslLightness), 1);
+    }
+
     property string wallpaperPath: {
         if (!GlobalStates.wallpaperManager) return "";
         let path = GlobalStates.wallpaperManager.currentWallpaper;
